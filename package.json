{
  "name": "intl-typegen",
  "description": "Generate typed translation hooks from JSON/YAML translation files for next-intl",
  "version": "0.0.0",
  "author": "Crescware Inc.",
  "bin": {
    "intl-typegen": "./dist/index.js"
  },
  "devDependencies": {
    "@types/node": "25.1.0",
    "@typescript/native-preview": "7.0.0-dev.20260124.1",
    "oxfmt": "0.27.0",
    "oxlint": "1.42.0",
    "package-directory": "^8.1.0",
    "tsup": "8.5.1",
    "turbo": "2.8.0",
    "typescript": "^5.9.3",
    "vitest": "4.0.18"
  },
  "keywords": [
    "next-intl",
    "i18n",
    "intl",
    "translation",
    "typegen",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crescware/intl-typegen.git"
  },
  "license": "MIT",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "tsup",
    "check": "turbo run turbo:check",
    "check:lint": "oxlint",
    "check:types": "tsgo --noEmit",
    "format": "oxfmt --write src",
    "test": "vitest run"
  },
  "type": "module",
  "dependencies": {
    "@formatjs/icu-messageformat-parser": "^3.5.1",
    "commander": "^14.0.2",
    "scule": "^1.3.0",
    "valibot": "^1.2.0",
    "yaml": "^2.8.2"
  }
}